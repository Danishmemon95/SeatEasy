# Server
PORT=5000
NODE_ENV=development

# Public URLs (used for CORS and for building links in verification emails)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/book_tickets

# Secret for signing JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Email
# "console" (default) prints each mail, with its links, to the server log instead of sending.
# "brevo" sends through Brevo's HTTPS API (Render's free plan blocks SMTP, HTTPS works).
MAIL_TRANSPORT=console
# Brevo -> SMTP & API -> API keys (the API key, not the SMTP key). Required when MAIL_TRANSPORT=brevo.
BREVO_API_KEY=
# A sender address verified under Brevo -> Senders, and the name people see. Required when MAIL_TRANSPORT=brevo.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SeatEase
# Mails per day (resets at midnight IST); past it, mails are skipped and logged. Keep below Brevo's ~300.
MAIL_DAILY_CAP=250
