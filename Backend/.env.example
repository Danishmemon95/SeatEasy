# Server
PORT=5000
NODE_ENV=development

# Public URLs (used for CORS and for building links in verification emails)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/book_tickets

# Secret for signing JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
